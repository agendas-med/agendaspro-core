# AgendasPRO core: copie para .env e preencha. NUNCA versione o .env real.
# Valores abaixo são fictícios/vazios. Gere segredos com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# --- Servidor ---------------------------------------------------------------
PORT=3001
NODE_ENV=development
# URL pública desta API (usada para montar /files/s3/<chave> quando o bucket é privado).
PUBLIC_API_URL=http://localhost:3001
# URL do front (links de e-mail; também vira a allowlist de CORS se CORS_ORIGINS estiver vazio).
URL_SITE=http://localhost:8080
# Origens permitidas no CORS, separadas por vírgula. Em produção é obrigatório.
CORS_ORIGINS=http://localhost:8080
# Limites de corpo JSON (padrão 1mb; /customers aceita imagem em base64).
BODY_LIMIT=1mb
UPLOAD_BODY_LIMIT=6mb

# --- Banco (MariaDB) --------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=agendaspro_db
MYSQL_USER=agendaspro
MYSQL_PASSWORD=
MYSQL_CONNECTION_LIMIT=10
# Só para o compose local e para os testes de integração (banco descartável).
MYSQL_ROOT_PASSWORD=

# --- Autenticação -----------------------------------------------------------
# Obrigatório: o boot falha sem ele. JWT_KEY é aceito como nome legado.
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Validade do refresh token rotativo (dias).
REFRESH_TOKEN_TTL_DAYS=30
# Google Sign-In
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Criptografia em repouso ------------------------------------------------
# base64 de exatamente 32 bytes (AES-256-GCM das chaves Asaas). Guarde com backup:
# sem ela as chaves cifradas ficam ilegíveis. Depois de configurar, rode
#   npm run db:encrypt-secrets   (cifra chaves legadas em texto puro)
APP_ENCRYPTION_KEY=

# --- Tokens de rotas internas (cada um diferente, 32+ caracteres) ----------
# /health/deep e rotas administrativas de /companies (header Authorization: Bearer <token>).
ADMIN_TOKEN=
# POST /internal/jobs/tick (header Authorization: Bearer <token>).
JOBS_TICK_TOKEN=

# --- Jobs e lembretes -------------------------------------------------------
# O gatilho é HORÁRIO e externo (cron-job.org ou GitHub Actions chamando
# POST /internal/jobs/tick a cada 1 hora), não a cada 5 min. Cada tick processa em
# lote por até ~20 s; o que sobrar continua no próximo tick. Lembretes cobrem
# agendamentos entre agora+1h e agora+24h30 (tolerante a ~1 h de atraso).
# Webhooks recebidos (Asaas/WhatsApp) também drenam jobs vencidos, com throttle no banco.
JOBS_TICK_BUDGET_MS=20000
JOBS_DRAIN_THROTTLE_SEC=300
# true força a drenagem oportunista mesmo com NODE_ENV=test.
JOBS_DRAIN_ON_WEBHOOK=
# Só para desenvolvimento local sem gatilho externo (Heroku Eco dorme: não use lá).
ENABLE_INPROCESS_CRON=false

# --- WhatsApp Cloud API (oficial, F4) -----------------------------------------
# Webhook: GET/POST /webhook/meta (verify token + X-Hub-Signature-256 com o App Secret).
WHATSAPP_CLOUD_ENABLED=false
META_APP_SECRET=
META_VERIFY_TOKEN=
# Token permanente de System User (whatsapp_business_messaging/management).
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
# Número exibido no wa.me (ex.: +55 11 0000-0000).
WHATSAPP_DISPLAY_PHONE=
META_GRAPH_URL=https://graph.facebook.com
META_GRAPH_VERSION=v21.0
WHATSAPP_TEMPLATE_LANG=pt_BR
# Mensagens por telefone por minuto (padrão 20) e horas até devolver ao bot (padrão 12).
WHATSAPP_INBOUND_MAX=
WHATSAPP_HUMAN_TIMEOUT_H=
# Processar o webhook no mesmo request (padrão: sim, exceto NODE_ENV=test).
WHATSAPP_INLINE_PROCESS=
# Reativa o relay legado (/webhook/whatsapp, whatsapp-web.js). Padrão desligado (410).
WHATSAPP_LEGACY_RELAY=false

# --- WhatsApp legado (descontinuado) -------------------------------------------
# Entrada (bot -> API, POST /webhook/whatsapp): header Authorization: Bearer <token>.
WHATSAPP_INBOUND_TOKEN=
# Saída (API -> serviço de envio): Bearer enviado no header ao WHATSAPP_API_URL.
WHATSAPP_OUTBOUND_TOKEN=
WHATSAPP_API_URL=
# Nome legado do token de entrada (fallback de WHATSAPP_INBOUND_TOKEN).
WEBHOOK_SECRET_TOKEN=

# --- Asaas ------------------------------------------------------------------
# sandbox | production
ASAAS_ENV=sandbox
# Chave da conta principal (criação de subcontas).
ASAAS_API_KEY=
ASAAS_MAIN_WALLET_ID=
# Token que o Asaas envia no header asaas-access-token dos webhooks.
ASAAS_WEBHOOK_TOKEN=
# URL pública do webhook (ex.: https://api.exemplo.test/webhook/asaas).
WEBHOOK_URL=

# --- OpenAI (bot) -----------------------------------------------------------
OPENAI_API_KEY=
# Modelo da IA do bot (só texto ambíguo; JSON estrito). Padrão gpt-6-luna.
OPENAI_MODEL_DEFAULT=gpt-6-luna
# Opcional: endpoint compatível (testes usam stub local).
OPENAI_BASE_URL=

# --- S3 (imagens) -----------------------------------------------------------
AWS_REGION=sa-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# false (padrão): bucket privado, entregue via /files/s3/<chave> com URL assinada (5 min).
# true: grava com ACL public-read (legado).
S3_PUBLIC_READ=false

# --- E-mail (Gmail OAuth2) --------------------------------------------------
USER_EMAIL=
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=

# --- Seed de demonstração (só local) ----------------------------------------
DEMO_PASSWORD=

# Fuso usado para converter datas em UTC (Z) no filtro de agendamentos
APP_TIMEZONE=America/Sao_Paulo

# --- F2: planos e assinatura ---
# Preço do Premium em centavos (padrão 4990 = R$ 49,90).
PLAN_PREMIUM_PRICE_CENTS=4990
# Dias de carência após o fim do período pago antes de voltar ao Free.
BILLING_GRACE_DAYS=3
# Liga a criação de assinaturas no Asaas (API key principal). false = rotas /billing respondem 503 billing_disabled ao assinar.
ASAAS_SUBSCRIPTIONS_ENABLED=false

# --- F3: API pública de agendamento (/public/*) ---
# Origens do site que chamam /public (vírgula); vazio = URL_SITE.
PUBLIC_CORS_ORIGINS=
# Base dos links de gestão enviados ao cliente (<PUBLIC_SITE_URL>/agendamento/<token>).
PUBLIC_SITE_URL=
# Segredo HMAC do manage_token (mín. 32 caracteres; gere aleatório). Trocar invalida links.
PUBLIC_BOOKING_TOKEN_SECRET=
# Validade do manage_token em dias (padrão 90).
PUBLIC_BOOKING_TOKEN_TTL_DAYS=
# Cloudflare Turnstile. Produção sempre verifica (sem segredo = 503).
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_URL=
# Só fora de produção: TURNSTILE_ENABLED=false + TURNSTILE_DEV_BYPASS=true desliga a checagem.
TURNSTILE_ENABLED=
TURNSTILE_DEV_BYPASS=
# Aviso de novos leads ao comercial (e-mail exige USER_EMAIL configurado).
SALES_NOTIFY_EMAIL=
SALES_NOTIFY_WHATSAPP=
# Limites (padrões: leads 5/h por IP e 3/dia por WhatsApp; reservas 10/h por IP e 5/dia por telefone; 20 slugs inexistentes/h).
PUBLIC_LEADS_IP_MAX=
PUBLIC_LEADS_PHONE_MAX=
PUBLIC_BOOKING_IP_MAX=
PUBLIC_BOOKING_PHONE_MAX=
PUBLIC_SLUG_MISS_MAX=
