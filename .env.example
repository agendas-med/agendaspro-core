# AgendasPRO core: copie para .env e preencha. NUNCA versione o .env real.
# Valores abaixo são fictícios/vazios. Gere segredos com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# --- Servidor ---------------------------------------------------------------
PORT=3001
NODE_ENV=development
# URL pública desta API (usada para montar /files/s3/<chave> quando o bucket é privado).
PUBLIC_API_URL=http://localhost:3001
# URL do front (links de e-mail; também vira a allowlist de CORS se CORS_ORIGINS estiver vazio).
URL_SITE=http://localhost:8080
# Origens permitidas no CORS, separadas por vírgula. Em produção é obrigatório.
CORS_ORIGINS=http://localhost:8080
# Limites de corpo JSON (padrão 1mb; /customers aceita imagem em base64).
BODY_LIMIT=1mb
UPLOAD_BODY_LIMIT=6mb

# --- Banco (MariaDB) --------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=agendaspro_db
MYSQL_USER=agendaspro
MYSQL_PASSWORD=
MYSQL_CONNECTION_LIMIT=10
# Só para o compose local e para os testes de integração (banco descartável).
MYSQL_ROOT_PASSWORD=

# --- Autenticação -----------------------------------------------------------
# Obrigatório: o boot falha sem ele. JWT_KEY é aceito como nome legado.
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Validade do refresh token rotativo (dias).
REFRESH_TOKEN_TTL_DAYS=30
# Google Sign-In
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Criptografia em repouso ------------------------------------------------
# base64 de exatamente 32 bytes (AES-256-GCM das chaves Asaas). Guarde com backup:
# sem ela as chaves cifradas ficam ilegíveis. Depois de configurar, rode
#   npm run db:encrypt-secrets   (cifra chaves legadas em texto puro)
APP_ENCRYPTION_KEY=

# --- Tokens de rotas internas (cada um diferente, 32+ caracteres) ----------
# /health/deep e rotas administrativas de /companies (header Authorization: Bearer <token>).
ADMIN_TOKEN=
# POST /internal/jobs/tick (header Authorization: Bearer <token>).
JOBS_TICK_TOKEN=

# --- Jobs e lembretes -------------------------------------------------------
# O gatilho é HORÁRIO e externo (cron-job.org ou GitHub Actions chamando
# POST /internal/jobs/tick a cada 1 hora), não a cada 5 min. Cada tick processa em
# lote por até ~20 s; o que sobrar continua no próximo tick. Lembretes cobrem
# agendamentos entre agora+1h e agora+24h30 (tolerante a ~1 h de atraso).
# Webhooks recebidos (Asaas/WhatsApp) também drenam jobs vencidos, com throttle no banco.
JOBS_TICK_BUDGET_MS=20000
JOBS_DRAIN_THROTTLE_SEC=300
# true força a drenagem oportunista mesmo com NODE_ENV=test.
JOBS_DRAIN_ON_WEBHOOK=
# Só para desenvolvimento local sem gatilho externo (Heroku Eco dorme: não use lá).
ENABLE_INPROCESS_CRON=false

# --- WhatsApp ---------------------------------------------------------------
# Entrada (bot -> API, POST /webhook/whatsapp): header Authorization: Bearer <token>.
WHATSAPP_INBOUND_TOKEN=
# Saída (API -> serviço de envio): Bearer enviado no header ao WHATSAPP_API_URL.
WHATSAPP_OUTBOUND_TOKEN=
WHATSAPP_API_URL=
# Nome legado do token de entrada (fallback de WHATSAPP_INBOUND_TOKEN).
WEBHOOK_SECRET_TOKEN=

# --- Asaas ------------------------------------------------------------------
# sandbox | production
ASAAS_ENV=sandbox
# Chave da conta principal (criação de subcontas).
ASAAS_API_KEY=
ASAAS_MAIN_WALLET_ID=
# Token que o Asaas envia no header asaas-access-token dos webhooks.
ASAAS_WEBHOOK_TOKEN=
# URL pública do webhook (ex.: https://api.exemplo.test/webhook/asaas).
WEBHOOK_URL=

# --- OpenAI (bot) -----------------------------------------------------------
OPENAI_API_KEY=

# --- S3 (imagens) -----------------------------------------------------------
AWS_REGION=sa-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# false (padrão): bucket privado, entregue via /files/s3/<chave> com URL assinada (5 min).
# true: grava com ACL public-read (legado).
S3_PUBLIC_READ=false

# --- E-mail (Gmail OAuth2) --------------------------------------------------
USER_EMAIL=
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=

# --- Seed de demonstração (só local) ----------------------------------------
DEMO_PASSWORD=
